FEATURE ?= opencode
# Keep this list in sync with the baseImage matrix in .github/workflows/test.yaml.
BASE_IMAGES ?= debian:latest ubuntu:latest mcr.microsoft.com/devcontainers/base:ubuntu opensuse/leap:latest

.PHONY: test test-scenarios test-autogenerated

test: test-scenarios test-autogenerated

test-scenarios:
	devcontainer features test -f $(FEATURE) --skip-autogenerated --skip-duplicated .

test-autogenerated:
	@set -e; for image in $(BASE_IMAGES); do \
		echo "Testing $(FEATURE) against $$image"; \
		devcontainer features test --skip-scenarios -f $(FEATURE) -i "$$image" .; \
	done
